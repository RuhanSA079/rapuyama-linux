// nokia e6 qwerty, the printed layout. fn (the arrow key, KEY_RIGHTALT in
// e6.dts) = level 3 = the yellow digits/symbols. sym toggles the groups
// (weston.ini: e6,e6(ru) + grp:menu_toggle + lv3:ralt_switch).
// fn+space = tab, fn+backspace = escape: the e6 has neither key

default partial alphanumeric_keys
xkb_symbols "basic" {
	include "us(basic)"
	name[Group1] = "English (Nokia E6)";

	key <AD01> { [ q, Q, exclam, exclam ] };
	key <AD02> { [ w, W, quotedbl, quotedbl ] };
	key <AD03> { [ e, E, plus, plus ] };
	key <AD04> { [ r, R, 1, 1 ] };
	key <AD05> { [ t, T, 2, 2 ] };
	key <AD06> { [ y, Y, 3, 3 ] };
	key <AD07> { [ u, U, asterisk, asterisk ] };
	key <AD08> { [ i, I, question, question ] };
	key <AD09> { [ o, O, bracketleft, braceleft ] };
	key <AD10> { [ p, P, bracketright, braceright ] };

	key <AC01> { [ a, A, percent, percent ] };
	key <AC02> { [ s, S, at, at ] };
	key <AC03> { [ d, D, slash, backslash ] };
	key <AC04> { [ f, F, 4, 4 ] };
	key <AC05> { [ g, G, 5, 5 ] };
	key <AC06> { [ h, H, 6, 6 ] };
	key <AC07> { [ j, J, numbersign, numbersign ] };
	key <AC08> { [ k, K, minus, underscore ] };
	key <AC09> { [ l, L, equal, equal ] };

	key <AB01> { [ z, Z, parenleft, parenleft ] };
	key <AB02> { [ x, X, parenright, parenright ] };
	key <AB03> { [ c, C, apostrophe, apostrophe ] };
	key <AB04> { [ v, V, 7, 7 ] };
	key <AB05> { [ b, B, 8, 8 ] };
	key <AB06> { [ n, N, 9, 9 ] };
	key <AB07> { [ m, M, 0, 0 ] };
	// the two cyrillic-only keys: something useful in english
	key <AC10> { [ dollar, ampersand, asciicircum, asciicircum ] };
	key <AC11> { [ bar, asciitilde, grave, grave ] };
	key <AB08> { [ comma, less, semicolon, semicolon ] };
	key <AB09> { [ period, greater, colon, colon ] };

	key <SPCE> { type[Group1] = "FOUR_LEVEL", [ space, space, Tab, Tab ] };
	key <BKSP> { type[Group1] = "FOUR_LEVEL", [ BackSpace, BackSpace, Escape, Escape ] };
};

partial alphanumeric_keys
xkb_symbols "ru" {
	include "e6(basic)"
	name[Group1] = "Russian (Nokia E6)";

	key <AD01> { [ Cyrillic_shorti, Cyrillic_SHORTI, exclam, exclam ] };
	key <AD02> { [ Cyrillic_tse, Cyrillic_TSE, quotedbl, quotedbl ] };
	key <AD03> { [ Cyrillic_u, Cyrillic_U, plus, plus ] };
	key <AD04> { [ Cyrillic_ka, Cyrillic_KA, 1, 1 ] };
	key <AD05> { [ Cyrillic_ie, Cyrillic_IE, 2, 2 ] };
	key <AD06> { [ Cyrillic_en, Cyrillic_EN, 3, 3 ] };
	key <AD07> { [ Cyrillic_ghe, Cyrillic_GHE, asterisk, asterisk ] };
	key <AD08> { [ Cyrillic_sha, Cyrillic_SHA, question, question ] };
	key <AD09> { [ Cyrillic_shcha, Cyrillic_SHCHA, Cyrillic_hardsign, Cyrillic_HARDSIGN ] };
	key <AD10> { [ Cyrillic_ze, Cyrillic_ZE, Cyrillic_ha, Cyrillic_HA ] };

	key <AC01> { [ Cyrillic_ef, Cyrillic_EF, percent, percent ] };
	key <AC02> { [ Cyrillic_yeru, Cyrillic_YERU, at, at ] };
	key <AC03> { [ Cyrillic_ve, Cyrillic_VE, slash, backslash ] };
	key <AC04> { [ Cyrillic_a, Cyrillic_A, 4, 4 ] };
	key <AC05> { [ Cyrillic_pe, Cyrillic_PE, 5, 5 ] };
	key <AC06> { [ Cyrillic_er, Cyrillic_ER, 6, 6 ] };
	key <AC07> { [ Cyrillic_o, Cyrillic_O, numbersign, numbersign ] };
	key <AC08> { [ Cyrillic_el, Cyrillic_EL, minus, underscore ] };
	key <AC09> { [ Cyrillic_de, Cyrillic_DE, equal, equal ] };

	key <AB01> { [ Cyrillic_ya, Cyrillic_YA, parenleft, parenleft ] };
	key <AB02> { [ Cyrillic_che, Cyrillic_CHE, parenright, parenright ] };
	key <AB03> { [ Cyrillic_es, Cyrillic_ES, apostrophe, apostrophe ] };
	key <AB04> { [ Cyrillic_em, Cyrillic_EM, 7, 7 ] };
	key <AB05> { [ Cyrillic_i, Cyrillic_I, 8, 8 ] };
	key <AB06> { [ Cyrillic_te, Cyrillic_TE, 9, 9 ] };
	key <AB07> { [ Cyrillic_softsign, Cyrillic_SOFTSIGN, 0, 0 ] };
	// printed б / ж and ю / э: the lower letter is the plain one
	key <AC10> { [ Cyrillic_be, Cyrillic_BE, Cyrillic_zhe, Cyrillic_ZHE ] };
	key <AC11> { [ Cyrillic_yu, Cyrillic_YU, Cyrillic_e, Cyrillic_E ] };
};