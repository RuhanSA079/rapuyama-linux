/dts-v1/;

/* device tree for the nokia e6 (rapuyama, arm1176jzf-s r0p4, armv6k)
 *
 * the peripheral phys bases below are the REAL ones, pulled from the firmware
 * mmu peripheral mapping table (rom virt 0x80001f9c, see docs/hw-memory-map.md)
 * and confirmed by live probing. what each mmio block actually *is* (uart/intc/
 * timer/watchdog) isnt pinned yet (the hal computes block->addr, its not a flat
 * table), that comes in the adapter phase. the /memory base is a sentinel the
 * booter patches to the allocated chunk phys base (ARM_PATCH_PHYS_VIRT)
 */

/ {
	compatible = "nokia,e6", "ti,rapuyama";
	model = "Nokia E6-00 (RapuYama)";
	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		bootargs = "console=ttyNULL rootwait panic=-1";
		/* add "earlycon=...,mmio32,0x........" once the uart base is known */
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu@0 {
			device_type = "cpu";
			compatible = "arm,arm1176jzf-s";
			reg = <0>;
		};
	};

	/* base 0x1badb002 = SENTINEL, the booter patches it to the chunk phys base */
	memory@0 {
		device_type = "memory";
		reg = <0x1badb002 0x02000000>; /* 32 mb inside the boot chunk */
	};

	/* top of dram regions the firmware reserves (videocore/codec/framebuffers),
	 * keep linux off them until we know what they are. phys, absolute */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		vc_reserved@20000000 {
			reg = <0x20000000 0x01000000>; /* 0x20000000..0x21000000 */
			no-map;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* REAL mmio blocks (phys bases from the firmware)
		 * what they are is a best guess, confirm/rename in the adapter phase
		 */
		/* structured regs (clock/sys ctrl), probably has the WATCHDOG */
		sysctrl@30000000 {
			compatible = "nokia,rapuyama-sysctrl";
			reg = <0x30000000 0x10000>;
		};
		/* 4 kb register file (afe/hal shadow) */
		periph_regfile@40000000 {
			compatible = "nokia,rapuyama-regfile";
			reg = <0x40000000 0x1000>;
		};
		/* 1 mb peripheral bank (reads FF = clock gated, uart/intc/timer probably here) */
		periph_bank@40100000 {
			compatible = "nokia,rapuyama-periph";
			reg = <0x40100000 0x100000>;
		};
		extbank0@8000000 { compatible = "nokia,rapuyama-extbank"; reg = <0x08000000 0x1000>; };
		extbank1@9000000 { compatible = "nokia,rapuyama-extbank"; reg = <0x09000000 0x1000>; };

		/* TODO once we know which block is which (adapter phase):
		 * intc@.. timer@.. uart@.. watchdog@.. (most likely inside
		 * sysctrl@30000000 or periph_bank@40100000)
		 */
	};
};