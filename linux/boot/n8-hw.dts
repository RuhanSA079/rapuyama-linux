/* n8-usb.dts + the n8 chips i2cdetect found (23.10.2026), see
 * docs/n8-hardware.md. only drivers that read or set up a sensor, the two
 * bq2415x chargers (i2c3 0x6a/0x6b), the led driver (0x33) and the
 * headphone amp (0x60) stay off */
/include/ "n8-usb.dts"

/ {
	/* all keys go straight to gpios and switch to gnd (schematic p4).
	 * polled, the gpio irq polarity is not known */
	gpio-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <50>;

		volume-up {
			label = "volume up";
			linux,code = <115>;		/* KEY_VOLUMEUP */
			gpios = <&gpio 2 1>;		/* active low */
		};
		volume-down {
			label = "volume down";
			linux,code = <114>;		/* KEY_VOLUMEDOWN */
			gpios = <&gpio 65 1>;
		};
		menu {
			label = "menu";
			linux,code = <172>;		/* KEY_HOMEPAGE */
			gpios = <&gpio 1 1>;
		};
		camera {
			label = "camera";
			linux,code = <212>;		/* KEY_CAMERA */
			gpios = <&gpio 36 1>;
		};
		camera-focus {
			label = "camera focus";
			linux,code = <528>;		/* KEY_CAMERA_FOCUS */
			gpios = <&gpio 38 1>;
		};
		lock {
			label = "lock slider";
			linux,code = <152>;		/* KEY_SCREENLOCK */
			gpios = <&gpio 79 1>;
		};
	};
};

&i2c0 {
	status = "okay";
	/delete-node/ keypad@44;
	/delete-node/ touchscreen@4a;

	/* N1105, ak8974 tells ak8974 / ami305 / ami306 apart itself */
	magnetometer@f {
		compatible = "asahi-kasei,ak8974";
		reg = <0x0f>;
	};

	/* N1103, SDO tied high */
	accelerometer@1d {
		compatible = "st,lis302dl";
		reg = <0x1d>;
	};

	/* touch flex X2500. maXTouch at 0x4b (the e6 one sits at 0x4a), the
	 * driver is polled and logs the info block, so a wrong guess just
	 * fails the probe */
	touchscreen@4b {
		compatible = "nokia,rapuyama-mxt";
		reg = <0x4b>;
	};
};

&i2c3 {
	status = "okay";

	/* V1100 */
	light-sensor@29 {
		compatible = "amstaos,tsl2563";
		reg = <0x29>;
	};
};

&charger {
	status = "disabled";
};
