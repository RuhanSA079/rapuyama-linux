/*
 * Nokia N8-00 (RM-596): everything verified on the phone so far (23.10.2026),
 * see docs/n8-status.md. Boots with n8boot.sis, which reads E:\n8.dtb.
 *
 * - SoC base, usb shell, ram log, eMMC, battery adc: e6.dts / e6-usb.dts,
 *   VideoCore node: e6-vc.dts (same RapuYama SoC and BCM2727 as the E6)
 * - watchdog with the startup mode word, so reboot goes back to Symbian
 * - side keys (gpio-keys-polled), Synaptics TM1284 touch (rmi4, polled),
 *   LIS302DL, AK8974, TSL2563
 * - VideoCore: loader B (loader A is refused on the N8), brought up right
 *   at boot (the first loader B boot powered the phone off, with debug=2
 *   and the E6 panel setup; without the 30 s delay it is fine now)
 * - display: the 360x640 DSI panel (id fe 94 80) on interface 6 with the N8
 *   panel path (videocore.panel=n8, kernel patch 0007), RGB565 frames over
 *   the gfx DMA engine (dma, rgb565, as on the E6): weston runs on it with
 *   the keys and touch (weston.ini wants rgb565)
 *
 * Left out on purpose: the E6 keypad (TC3589x) and maXTouch nodes (not on the
 * N8), the bq2415x chargers (not tested on the N8, boot with a charged
 * battery), the LED driver, the headphone amp.
 */
/include/ "e6-vc.dts"

/ {
	compatible = "nokia,n8", "nokia,rapuyama";
	model = "Nokia N8-00 (RapuYama)";

	chosen {
		bootargs = "earlycon=ramcon,0x1f000000 keep_bootcon console=tty0 panic=10 nohlt clk_ignore_unused pd_ignore_unused cma=0 rootfstype=ramfs e6.usbsh e6.nogui videocore.debug=1 videocore.loader_b=1 videocore.dma=1 videocore.rgb565=1 videocore.panel=n8 wlcore.irq_poll_ms=10";
	};
	/* all keys go straight to gpios and switch to gnd (schematic p4).
	 * polled, the gpio irq polarity is not known */
	gpio-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <50>;

		volume-up {
			label = "volume up";
			linux,code = <115>;		/* KEY_VOLUMEUP */
			gpios = <&gpio 2 1>;		/* active low */
		};
		volume-down {
			label = "volume down";
			linux,code = <114>;		/* KEY_VOLUMEDOWN */
			gpios = <&gpio 65 1>;
		};
		menu {
			label = "menu";
			linux,code = <172>;		/* KEY_HOMEPAGE */
			gpios = <&gpio 1 1>;
		};
		camera {
			label = "camera";
			linux,code = <212>;		/* KEY_CAMERA */
			gpios = <&gpio 36 1>;
		};
		camera-focus {
			label = "camera focus";
			linux,code = <528>;		/* KEY_CAMERA_FOCUS */
			gpios = <&gpio 38 1>;
		};
		lock {
			label = "lock slider";
			linux,code = <152>;		/* KEY_SCREENLOCK */
			gpios = <&gpio 79 1>;
		};
	};
};

/* the N8's ISA software data (the security server behind the PA_SWD secure
 * watchdog: token, heap, protected application table, stacks) is at VA
 * 0xc6800000 +0x280000 = phys 0x1fd50000..0x1ffcffff (swdvadump 24.10.2026,
 * via the L1 copy in the isah block), in ordinary linux ram: the E6's
 * shm@1f8b0000 does not cover it. found intact early after boot (token 240,
 * live heap, a PA_SWD request in the pool), keep linux off it. not no-map,
 * same reason as the E6 nodes (a no-map hole near the top of ram) */
&{/reserved-memory} {
	isasw@1fd50000 {
		reg = <0x1fd50000 0x280000>;
	};
};

/* the startup mode word as 4th reg: rebootdriver.ldd sets bits 20-23 before
 * the soc reset. left at 0 the n8 powers off after a reboot instead of
 * booting Symbian, 0xe (normal restart) brings it back */
&{/soc/watchdog@20030700} {
	reg = <0x20030700 0x40>, <0x200336c4 0x4>, <0x20033114 0x4>,
	      <0x20040400 0x4>;
};


&i2c0 {
	status = "okay";
	/delete-node/ keypad@44;
	/delete-node/ touchscreen@4a;

	/* N1105, ak8974 tells ak8974 / ami305 / ami306 apart itself */
	magnetometer@f {
		compatible = "asahi-kasei,ak8974";
		reg = <0x0f>;
	};

	/* N1103, SDO tied high */
	accelerometer@1d {
		compatible = "st,lis302dl";
		reg = <0x1d>;
	};

	/* touch flex X2500: Synaptics ClearPad TM1284_1, RMI4 (i2cdump on the
	 * phone: product id at 0x7e, PDT F34 / F01 / F08 / F11 at 0xe9..0xd7).
	 * no interrupts: the ATTN gpio has no working irq, rmi4 polls */
	touchscreen@4b {
		compatible = "syna,rmi4-i2c";
		reg = <0x4b>;
		#address-cells = <1>;
		#size-cells = <0>;

		rmi4-f01@1 {
			reg = <0x01>;
			syna,nosleep-mode = <1>;
		};

		/* raw x runs top -> bottom along the long side, raw y right -> left
		 * (phone upright, menu key at the bottom). rmi4 flips, then
		 * swaps: inverted-y + swapped-x-y = x left -> right 0..1756,
		 * y top -> bottom 0..3155, matching the 360x640 panel. checked
		 * with fbtouch: with inverted-x as well, every touch landed in
		 * the box above / below the one touched (23.10.2026) */
		rmi4-f11@11 {
			reg = <0x11>;
			touchscreen-inverted-y;
			touchscreen-swapped-x-y;
		};
	};
};

&i2c3 {
	status = "okay";

	/* V1100 */
	light-sensor@29 {
		compatible = "amstaos,tsl2563";
		reg = <0x29>;
	};
};

&charger {
	status = "disabled";
};

/*
 * WLAN: TI WL1271 PG2.0 on spi2 (WSPI), verified 24.10.2026: firmware
 * wl127x-fw-5-sr boots, scan, WPA2 connect, DHCP, internet. Needs:
 * - n8boot's WLAN step before the jump (default on, E:\nowlan.txt skips it):
 *   PowerResourceManager 0x25 = the 19.2 MHz reference clock the modem gates,
 *   then genio100 high. Without it the chip id reads garbage
 * - kernel patches 0008 (spi-rapuyama), 0009 (wl12xx binds the spi glue's
 *   wl127x device), 0010 (32 bit words as byte frames), 0013 (wlcore
 *   irq_poll_ms: the genio73 interrupt never reaches the cpu, the bootarg
 *   above polls the chip's interrupt status every 10 ms instead)
 * - firmware + the phone's own NVS (MAC, calibration) in the initramfs
 *   (build-vc.sh, work/wlan/fw, not in git)
 * - runtime PM off for the wlcore device (init does it): waking the chip
 *   from ELP times out
 * Evidence: work/spi-n8/NOTES.md, docs/n8-status.md
 */
/ {
	clocks {
		/* spi functional clock: spi2.dll FUN_801115c8 computes
		 * sclk = 192000 kHz / 2 / (div + 1) */
		spi_fclk: spi-fclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <192000000>;
		};
	};

	/* wlanhpa.dll config 0x8038a0a4: enable = genio100, active high,
	 * NKern::Sleep(12) after power on. always on: n8boot already powered
	 * the chip with its clock, a power cycle in linux is not needed */
	wlan_en: regulator-wlan-en {
		compatible = "regulator-fixed";
		regulator-name = "wlan-en";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio 100 0>;
		enable-active-high;
		startup-delay-us = <12000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&{/soc} {
	/* spi2.dll, the WLAN's controller. second reg = the block shared by
	 * spi1/2/3 (0x804 = clock enable). polled driver */
	spi2: spi@20020600 {
		compatible = "nokia,rapuyama-spi";
		reg = <0x20020600 0x80>, <0x20020800 0x40>;
		/* resource 0x1c = cgc gate 0x0c (0x200330d0 bit 8) */
		clocks = <&cgc 0x1c>, <&spi_fclk>;
		clock-names = "ick", "fck";
		#address-cells = <1>;
		#size-cells = <0>;

		wlan@0 {
			compatible = "ti,wl1271";
			reg = <0>;
			/* 1 and 8 MHz verified (8: firmware upload 0.45 s) */
			spi-max-frequency = <8000000>;
			/* WLAN_IRQ = genio73. it never delivers the firmware's
			 * events (rising fires only on release, falling and
			 * level low never), wlcore.irq_poll_ms does the work.
			 * kept as a harmless extra */
			interrupts-extended = <&gpio 73 1>;
			vwlan-supply = <&wlan_en>;
			/* the phone's INI: ref_clock 2 = 38.4 MHz; wl12xx sends
			 * this, not the NVS value (19.2: the scan hears nothing) */
			ref-clock-frequency = <38400000>;
		};
	};
};
