From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ruhan van der Berg <35257374+RuhanSA079@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:24:12 +0200
Subject: [PATCH 4/6] soc: rapuyama: videocore: dspc_id parameter

The display chipset interface was fixed at 4, the E6's RGB panel. On the
N8 (360x640 DSI panel) the VC boots with loader B and pushes frames, but
every panel read through interface 4 is 0. videocore.dspc_id selects the
interface (default 4), to try 6, the other one in the chipset table.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soc/rapuyama/videocore.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/rapuyama/videocore.c b/drivers/soc/rapuyama/videocore.c
index 4608eb23d..09a3483d4 100644
--- a/drivers/soc/rapuyama/videocore.c
+++ b/drivers/soc/rapuyama/videocore.c
@@ -146,7 +146,6 @@ static inline u16 vc_565(u32 p)
 	return (p >> 8 & 0xf800) | (p >> 5 & 0x07e0) | (p >> 3 & 0x001f);
 }
 
-#define DSPC_ID	4		/* display chipset interface, E6 = 4 */
 #define DSPC_ALL 0xffff
 
 #define DISP_REPLY 0x80000000
@@ -213,6 +212,13 @@ static bool partial;
 module_param(partial, bool, 0644);
 MODULE_PARM_DESC(partial, "push only the changed rows, BROKEN on the phone (the VC ignores the write rects)");
 
+/* display chipset interface: 4 = the E6's RGB/video panel. the chipset table
+ * (0x8034eaa4 in the E6 ROM) has one more, 6, likely the DSI one the N8's
+ * 360x640 panel hangs on */
+static unsigned int dspc_id = 4;
+module_param(dspc_id, uint, 0444);
+MODULE_PARM_DESC(dspc_id, "display chipset interface id (E6 = 4, try 6 for a DSI panel)");
+
 /* wait this long before touching the VC: a boot that hangs in the bring-up
  * then still gets the usb shell up first, to watch it with dmesg -w */
 static unsigned int start_delay;
@@ -1225,7 +1231,7 @@ static int dspc_simple(struct vc *vc, u32 cmd, u32 arg)
 {
 	__le32 a = cpu_to_le32(arg);
 
-	return dspc_call(vc, DSPC_ALL, DSPC_ID, cmd, &a, 4);
+	return dspc_call(vc, DSPC_ALL, dspc_id, cmd, &a, 4);
 }
 
 /*
@@ -1244,7 +1250,7 @@ static int dspc_config(struct vc *vc)
 		put_unaligned_le16(h16[i], pl + 2 * i);
 	put_unaligned_le32(20000000, pl + 24);
 	put_unaligned_le32(2000000, pl + 28);
-	return dspc_send(vc, 0, DSPC_ID, 3, 0, pl, sizeof(pl));
+	return dspc_send(vc, 0, dspc_id, 3, 0, pl, sizeof(pl));
 }
 
 struct dcs {
@@ -1275,7 +1281,7 @@ static int dspc_batch(struct vc *vc, const struct dcs *c, unsigned int n)
 		memcpy(pl + off, c[i].data, c[i].len);
 		off += pad;
 	}
-	return dspc_call(vc, DSPC_ALL, DSPC_ID, 0x40, pl, off);
+	return dspc_call(vc, DSPC_ALL, dspc_id, 0x40, pl, off);
 }
 
 /*
@@ -1291,7 +1297,7 @@ static int dspc_read(struct vc *vc, u8 cmd, u8 *data, u32 n)
 	int ret;
 
 	vc->dspc_rx_seen = false;
-	ret = dspc_send(vc, DSPC_ALL, DSPC_ID, 0x40, 0, pl, sizeof(pl));
+	ret = dspc_send(vc, DSPC_ALL, dspc_id, 0x40, 0, pl, sizeof(pl));
 	if (ret)
 		return ret;
 	ret = dspc_wait(vc, tok);
